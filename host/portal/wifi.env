# PUBLIC DEMO hotspot credentials. The published lid has these embossed as a Wi-Fi
# QR code (enclosure/qr_emboss.json). Anyone can read them here, so before building
# your own unit put your own SSID/PASSWORD in wifi.local.env (gitignored) and run
# tools/qr_emboss.py to make a matching QR (see README > Colouring the embossed QR).
SSID=HUMDRUM
PASSWORD=humdrum-demo
