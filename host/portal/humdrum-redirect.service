[Unit]
Description=Humdrum captive portal redirector (port 80 -> web UI)
After=network.target

[Service]
Environment=PORTAL_TARGET=http://@AP_IP@:@APP_PORT@/
Environment=PORTAL_PORT=80
ExecStart=/usr/bin/python3 /usr/local/lib/humdrum/portal-redirect.py
Restart=always
RestartSec=2
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
